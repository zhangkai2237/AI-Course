{
  "chapters": [
    {
      "c": 1,
      "part": "第一篇·定问题",
      "name": "业务背景",
      "question": "审核慢，具体慢在哪里？",
      "steps": [
        "1.1 看日常审核流程",
        "1.2 核实文案中的业务承诺",
        "1.3 找出重复劳动与往返"
      ],
      "output": "角色流程与三类痛点",
      "bridge": "把痛点转成首版目标",
      "end": 10
    },
    {
      "c": 2,
      "part": "第一篇·定问题",
      "name": "目标与范围",
      "question": "第一版，究竟让谁少做什么？",
      "steps": [
        "2.1 把提效写成工作变化",
        "2.2 划定首版范围与人工责任"
      ],
      "output": "首版目标与范围说明",
      "bridge": "把目标接进三个审核环节",
      "end": 12
    },
    {
      "c": 3,
      "part": "第二篇·做方案",
      "name": "三段流程",
      "question": "自检、审核、巡检，怎样接成闭环？",
      "steps": [
        "3.1 事前：让作者知道怎么改",
        "3.2 事中：确认、修改与复核",
        "3.3 事后：圈范围并跟踪更新"
      ],
      "output": "触发—处理—责任的三段流程",
      "bridge": "把流程里的检查拆成审核点",
      "end": 20
    },
    {
      "c": 4,
      "part": "第二篇·做方案",
      "name": "审核点",
      "question": "一条要求，怎样变成可执行的检查？",
      "steps": [
        "4.1 定义审核点的六个要素",
        "4.2 用温度、价格和赠品试写",
        "4.3 把不同结果分到下一步动作"
      ],
      "output": "一张包含边界与处理的审核点卡",
      "bridge": "再决定程序、模型和人怎样执行",
      "end": 26
    },
    {
      "c": 5,
      "part": "第二篇·做方案",
      "name": "能力分工",
      "question": "哪些交程序，哪些交模型，哪些留给人？",
      "steps": [
        "5.1 定义混合审核并比较方案",
        "5.2 拆解一条检查的执行接力",
        "5.3 为无法判断与失败安排交接"
      ],
      "output": "输入—分工—结果—兜底的执行链",
      "bridge": "把执行链接到页面、状态与记录",
      "end": 33
    },
    {
      "c": 6,
      "part": "第二篇·做方案",
      "name": "产品方案",
      "question": "用户点一下，系统怎样可靠地走完？",
      "steps": [
        "6.1 组织架构、数据流和记录",
        "6.2 解决正文版本与迟到结果",
        "6.3 用页面承接角色、动作和异常"
      ],
      "output": "架构、版本状态与页面操作方案",
      "bridge": "用小范围试用检验能否落地",
      "end": 44
    },
    {
      "c": 7,
      "part": "第三篇·验落地",
      "name": "实施验证",
      "question": "怎样证明方案可用，而且真的提效？",
      "steps": [
        "7.1 确认依赖并安排建设顺序",
        "7.2 同时验证质量与整项人工投入",
        "7.3 用证据决定修复、扩大或收缩"
      ],
      "output": "一页实施与验证安排",
      "bridge": "回到业务目标，说明方案与证据的关系",
      "end": 54
    }
  ],
